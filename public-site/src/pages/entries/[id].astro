---
import { marked } from 'marked'
import Layout from '../../layouts/Layout.astro'
import projects from '../../config/projects.json'

export function getStaticPaths() {
  return projects.flatMap((project) =>
    [1, 2, 3].map((sampleIndex) => ({
      params: { id: `${project.slug}-sample-${sampleIndex}` },
      props: { project, sampleIndex },
    })),
  )
}

const { id, project, sampleIndex } = Astro.props

const articleTitles = [
  `${project.title} kickoff note`,
  `${project.title} implementation log`,
  `${project.title} follow-up`,
]

const articleDates = ['2026-05-07', '2026-05-04', '2026-04-29']

const articleTitle = articleTitles[sampleIndex - 1]

const markdown = `# ${articleTitle}

This page demonstrates the article layout.

## Notes

- Date is prominent
- Tags stay close to the header
- Markdown blocks need breathing room

> The body should stay readable even when it contains code, tables, and diagrams.

### Code

\`\`\`ts
export function summarize(entry: string) {
  return entry.trim()
}
\`\`\`

### Table

| Field | Value |
| --- | --- |
| Project | ${project.title} |
| Entry id | ${id} |
| Status | Draft |

### Diagram

\`\`\`mermaid
flowchart TD
  A[Draft] --> B[Review]
B --> C[Publish]
\`\`\`
`

const bodyMarkdown = markdown.startsWith(`# ${articleTitle}\n\n`) ? markdown.slice(articleTitle.length + 4) : markdown

const rendered = marked.parse(bodyMarkdown, { breaks: true })
---

<Layout title={`${project.title} article | Archive`}>
  <article class="site-article-shell">
    <section class="site-pane site-article-head">
      <div class="site-page-heading">
        <p class="site-eyebrow">Article page</p>
        <h1 class="site-title">{articleTitle}</h1>
      </div>

      <div class="site-article-meta">
        <div class="site-date">{articleDates[sampleIndex - 1]}</div>
        <div class="site-tag-row">
          {project.tags.map((tag) => <span class="site-tag">{tag}</span>)}
          <span class="site-tag">draft</span>
        </div>
      </div>

      <div class="site-article-nav">
        <a class="site-chip" href={`/${project.slug}/`}>Back to project</a>
        <a class="site-chip" href={`/entries/${project.slug}-sample-${Math.max(sampleIndex - 1, 1)}/`}>Previous article</a>
        <a class="site-chip" href={`/entries/${project.slug}-sample-${Math.min(sampleIndex + 1, 3)}/`}>Next article</a>
      </div>
    </section>

    <section class="site-pane">
      <div class="site-pane-inner">
        <div class="site-article-body" set:html={rendered}></div>
        <div class="site-article-nav" style="margin-top: 1.5rem;">
          <a class="site-chip" href={`/${project.slug}/`}>Back to project</a>
          <a class="site-chip" href={`/entries/${project.slug}-sample-${Math.max(sampleIndex - 1, 1)}/`}>Previous article</a>
          <a class="site-chip" href={`/entries/${project.slug}-sample-${Math.min(sampleIndex + 1, 3)}/`}>Next article</a>
        </div>
      </div>
    </section>
  </article>
</Layout>
