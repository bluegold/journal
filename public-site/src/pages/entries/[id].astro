---
import Layout from '../../layouts/Layout.astro'
import _projects from '../../config/projects.json'
import siteConfig from '../../config/site-config.json'
import { getEntry, getEntries } from '../../lib/api'
import { buildArchiveMonthPath } from '../../lib/archive'
import { getProjectExcludeTags } from '../../lib/project-filters'
import { stripRedundantLeadingHeading } from '../../lib/markdown'
import { renderMarkdown } from '../../lib/render-markdown'

export async function getStaticPaths() {
  const canUseAPI = Boolean(import.meta.env.JOURNAL_BASE_URL && import.meta.env.JOURNAL_API_TOKEN)

  if (!canUseAPI) {
    return []
  }

  const paths = []

  for (const project of _projects) {
    try {
      const entries = await getEntries(project.tags, undefined, getProjectExcludeTags(project))
      const sortedEntries = [...entries].sort((left, right) => right.journalDate.localeCompare(left.journalDate))

      sortedEntries.forEach((entry, index) => {
        paths.push({
          params: { id: entry.id },
          props: {
            id: entry.id,
            project,
            prevId: sortedEntries[index - 1]?.id,
            nextId: sortedEntries[index + 1]?.id,
          },
        })
      })
    } catch {
    }
  }

  return paths
}

const canUseAPI = Boolean(import.meta.env.JOURNAL_BASE_URL && import.meta.env.JOURNAL_API_TOKEN)
const { id: _id, project, prevId: _prevId, nextId: _nextId } = Astro.props

void Layout
void _projects
void siteConfig

if (!canUseAPI) {
  throw new Error('JOURNAL_BASE_URL and JOURNAL_API_TOKEN must be set to render article pages')
}

const entry = await getEntry(_id)
const _articleTitle = entry.title
const _articleDate = entry.journalDate
const _articleTags = entry.tags.length > 0 ? entry.tags : project.tags
const _bodyMarkdown = stripRedundantLeadingHeading(entry.body, _articleTitle)
const _rendered = await renderMarkdown(_bodyMarkdown)
const _monthHref = buildArchiveMonthPath(project.slug, _articleDate.slice(0, 7))
const _prevHref = _prevId ? `/entries/${_prevId}/` : null
const _nextHref = _nextId ? `/entries/${_nextId}/` : null
---

<Layout title={`${siteConfig.siteTitle} | ${project.title} | ${_articleTitle}`}>
  <article class="site-article-shell">
    <section class="site-pane site-article-head">
      <div class="site-page-heading">
        <p class="site-eyebrow">Article page</p>
        <h1 class="site-title">{_articleTitle}</h1>
      </div>

      <div class="site-article-meta">
        <div class="site-date">{_articleDate}</div>
        <div class="site-tag-row">
          {_articleTags.map((tag) => <span class="site-tag">{tag}</span>)}
          <span class="site-tag">draft</span>
        </div>
      </div>

      <div class="site-article-nav">
        <a class="site-chip" href={_monthHref}>Back to month</a>
        {_prevHref ? (
          <a class="site-chip" href={_prevHref}>Previous article</a>
        ) : (
          <span class="site-chip site-chip--disabled" aria-disabled="true">Previous article</span>
        )}
        {_nextHref ? (
          <a class="site-chip" href={_nextHref}>Next article</a>
        ) : (
          <span class="site-chip site-chip--disabled" aria-disabled="true">Next article</span>
        )}
      </div>
    </section>

    <section class="site-pane">
      <div class="site-pane-inner">
        <div class="site-article-body" set:html={_rendered}></div>
        <div class="site-article-nav" style="margin-top: 1.5rem;">
          <a class="site-chip" href={_monthHref}>Back to month</a>
          {_prevHref ? (
            <a class="site-chip" href={_prevHref}>Previous article</a>
          ) : (
            <span class="site-chip site-chip--disabled" aria-disabled="true">Previous article</span>
          )}
          {_nextHref ? (
            <a class="site-chip" href={_nextHref}>Next article</a>
          ) : (
            <span class="site-chip site-chip--disabled" aria-disabled="true">Next article</span>
          )}
        </div>
      </div>
    </section>
  </article>
</Layout>
