---
import Layout from '../../layouts/Layout.astro'
import projects from '../../config/projects.json'

const topBadges = ['Centered', 'Sticky header', 'Matrix background', 'Translucent panel']

void Layout
void projects
void topBadges

---

<Layout title="Archive">
  <div class="site-stack">
    <section class="site-pane site-pane--strong site-top-hero">
      <div class="site-pane-inner site-top-hero-copy">
        <div class="site-page-heading">
          <p class="site-eyebrow">Top page</p>
          <h1 class="site-title">Archive</h1>
        </div>
        <p class="site-copy">
          これはプロジェクトと記事に入るための入口。暗い背景、matrix rain、中央寄せの透過パネルを共通の土台にする。
        </p>
        <div class="site-badge-row">
          {topBadges.map((label) => <span class="site-badge">{label}</span>)}
        </div>
      </div>

      <div class="site-pane site-pane--strong">
        <div class="site-pane-inner site-stack">
          <div class="site-project-tile-image" aria-hidden="true"></div>
          <div class="site-meta-row">
            <span class="site-date">Project index</span>
            <span class="site-chip">Latest notes first</span>
          </div>
          <p class="site-summary">
            Top は入口として、プロジェクト一覧へ進むための summary surface を置く。
          </p>
        </div>
      </div>
    </section>

    <section class="site-project-grid" aria-label="Projects">
      {projects.map((project) => (
        <a class="site-pane site-project-tile" href={`/sample/${project.slug}/`}>
          <div class="site-pane-inner site-stack">
            <div class="site-meta-row">
              <div class="site-date">{project.title}</div>
              <div class="site-tag-row">
                {project.tags.map((tag) => <span class="site-tag">{tag}</span>)}
              </div>
            </div>

            <div class="site-project-tile-image" aria-hidden="true"></div>

            <div>
              <h2 class="site-project-tile-title">{project.subtitle}</h2>
              <p class="site-project-tile-summary">{project.summary}</p>
            </div>

            <div class="site-action-row">
              <span class="site-detail-button">Open project</span>
            </div>
          </div>
        </a>
      ))}
    </section>
  </div>
</Layout>
