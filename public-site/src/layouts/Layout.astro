---
import siteConfig from '../config/site-config.json'

const { title: _title } = Astro.props
void siteConfig

const symbols = ['M', 'A', 'T', 'R', 'I', 'X', '0', '1']
const _columns = Array.from({ length: 14 }, (_, columnIndex) =>
  Array.from({ length: 18 }, (_, rowIndex) => {
    const symbol = symbols[(columnIndex + rowIndex) % symbols.length]
    const top = -(60 + rowIndex * 7.5 + (columnIndex % 5) * 6.5)
    return {
      symbol,
      top: `${top}vh`,
      duration: `${4.2 + ((columnIndex + rowIndex) % 7) * 0.6}s`,
      delay: `${(columnIndex * 0.14 + rowIndex * 0.08).toFixed(2)}s`,
      opacity: `${0.26 + ((columnIndex + rowIndex) % 6) * 0.12}`,
      size: `${0.9 + ((columnIndex + rowIndex) % 4) * 0.16}rem`,
      drift: `${(((columnIndex * 3 + rowIndex) % 7) - 3) * 1.15}rem`,
    }
  }),
)
---

<!doctype html>
<html lang="ja" class="bg-black text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{_title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" crossOrigin="anonymous"></script>
    <script src="/embedded-diagrams.js" defer></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=Cormorant+Garamond:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const setBackgroundOffset = (name, values) => {
          for (const [key, value] of Object.entries(values)) {
            document.documentElement.style.setProperty(`--${name}-${key}`, value)
          }
        }

        const randomRange = (min, max) => Math.random() * (max - min) + min
        const formatVw = (value) => `${value.toFixed(2)}vw`
        const formatVh = (value) => `${value.toFixed(2)}vh`

        const modes = [
          { name: 'searchlight', weight: 5 },
          { name: 'aurora', weight: 3 },
          { name: 'matrix', weight: 2 },
        ]
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        const pool = reducedMotion ? modes.filter((mode) => mode.name !== 'matrix') : modes
        const totalWeight = pool.reduce((sum, mode) => sum + mode.weight, 0)
        let roll = Math.random() * totalWeight

        for (const mode of pool) {
          roll -= mode.weight
          if (roll <= 0) {
            document.documentElement.dataset.siteBackground = mode.name
            setBackgroundOffset('site-searchlight-one', {
              top: formatVh(randomRange(-14, -2)),
              left: formatVw(randomRange(-18, -6)),
            })
            setBackgroundOffset('site-searchlight-two', {
              top: formatVh(randomRange(12, 26)),
              right: formatVw(randomRange(-16, -4)),
            })
            setBackgroundOffset('site-searchlight-three', {
              bottom: formatVh(randomRange(-16, -6)),
              left: formatVw(randomRange(14, 36)),
            })
            setBackgroundOffset('site-aurora-one', {
              top: formatVh(randomRange(-14, -2)),
              left: formatVw(randomRange(-10, 4)),
            })
            setBackgroundOffset('site-aurora-two', {
              top: formatVh(randomRange(8, 22)),
              right: formatVw(randomRange(-12, 2)),
            })
            setBackgroundOffset('site-aurora-three', {
              bottom: formatVh(randomRange(-14, -4)),
              left: formatVw(randomRange(16, 42)),
            })
            console.log(`[public-site] background mode: ${mode.name}`)
            return
          }
        }

        const fallbackMode = pool[0]?.name ?? 'searchlight'
        document.documentElement.dataset.siteBackground = fallbackMode
        setBackgroundOffset('site-searchlight-one', {
          top: formatVh(randomRange(-14, -2)),
          left: formatVw(randomRange(-18, -6)),
        })
        setBackgroundOffset('site-searchlight-two', {
          top: formatVh(randomRange(12, 26)),
          right: formatVw(randomRange(-16, -4)),
        })
        setBackgroundOffset('site-searchlight-three', {
          bottom: formatVh(randomRange(-16, -6)),
          left: formatVw(randomRange(14, 36)),
        })
        setBackgroundOffset('site-aurora-one', {
          top: formatVh(randomRange(-14, -2)),
          left: formatVw(randomRange(-10, 4)),
        })
        setBackgroundOffset('site-aurora-two', {
          top: formatVh(randomRange(8, 22)),
          right: formatVw(randomRange(-12, 2)),
        })
        setBackgroundOffset('site-aurora-three', {
          bottom: formatVh(randomRange(-14, -4)),
          left: formatVw(randomRange(16, 42)),
        })
        console.log(`[public-site] background mode: ${fallbackMode}`)
      })()
    </script>
    <style is:global>
      :root {
        color-scheme: dark;
        --site-border: rgba(255, 255, 255, 0.09);
        --site-pane: rgba(15, 23, 42, 0.32);
        --site-pane-strong: rgba(15, 23, 42, 0.44);
        --site-text: rgb(241 245 249);
        --site-muted: rgb(203 213 225);
        --site-dim: rgb(148 163 184);
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background:
          radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.12), transparent 30%),
          radial-gradient(circle at 80% 0%, rgba(34, 197, 94, 0.1), transparent 24%),
          #020308;
        color: var(--site-text);
        font-family: 'Inter', sans-serif;
        text-rendering: optimizeLegibility;
      }

      * {
        box-sizing: border-box;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .site-shell {
        position: relative;
        isolation: isolate;
        min-height: 100vh;
      }

      .site-shell::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.03), transparent 18%);
        z-index: -2;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(20px);
        background: rgba(2, 6, 23, 0.72);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .site-progress {
        position: fixed;
        inset: 0 auto auto 0;
        z-index: 60;
        width: 100%;
        height: 2px;
        background: transparent;
        pointer-events: none;
      }

      .site-progress::before {
        content: '';
        display: block;
        width: 100%;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left center;
        background: linear-gradient(to right, rgba(74, 222, 128, 0.95), rgba(59, 130, 246, 0.95));
        transition: transform 180ms ease;
      }

      .site-progress.is-active::before {
        transform: scaleX(1);
      }

      .site-container {
        width: min(80%, 70rem);
        margin: 0 auto;
        padding-left: clamp(1rem, 3vw, 2rem);
        padding-right: clamp(1rem, 3vw, 2rem);
      }

      .site-main {
        width: min(80%, 70rem);
        margin: 0 auto;
        padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem) clamp(4rem, 7vw, 6rem);
      }

      .site-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.5rem;
      }

      .site-brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
      }

      .site-brand-mark {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 999px;
        background: rgba(74, 222, 128, 0.95);
        box-shadow: 0 0 20px rgba(74, 222, 128, 0.55);
      }

      .site-brand-title {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
      }

      .site-brand-subtitle {
        margin-top: 0.2rem;
        font-size: 0.62rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--site-dim);
      }

      .site-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 0.55rem 0.85rem;
        font-size: 0.62rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.03);
      }

      .site-chip--disabled {
        opacity: 0.35;
        cursor: not-allowed;
        pointer-events: none;
      }

      .site-background {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }

      .site-background-layer {
        position: absolute;
        inset: 0;
        display: none;
        overflow: hidden;
      }

      html[data-site-background='matrix'] .site-background-layer--matrix,
      html[data-site-background='searchlight'] .site-background-layer--searchlight,
      html[data-site-background='aurora'] .site-background-layer--aurora,
      html:not([data-site-background]) .site-background-layer--searchlight {
        display: block;
      }

      .site-matrix {
        position: absolute;
        inset: 0;
        mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
      }

      .site-columns {
        position: relative;
        width: 100%;
        height: 100%;
      }

      .site-column {
        position: absolute;
        top: -20vh;
        bottom: -20vh;
        width: 1.25rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 1rem;
        line-height: 1;
        color: rgba(74, 222, 128, 0.78);
        text-shadow: 0 0 20px rgba(74, 222, 128, 0.42);
        opacity: 0.96;
      }

      .site-cell {
        position: absolute;
        left: 50%;
        display: block;
        transform-origin: center;
        animation: site-fall linear infinite;
        font-weight: 600;
        will-change: transform, opacity;
        --drift: 0rem;
      }

      @media (prefers-reduced-motion: reduce) {
        .site-cell,
        .site-searchlight,
        .site-searchlight-beam,
        .site-aurora-glow {
          animation: none !important;
        }

        html[data-site-background='matrix'] .site-background-layer--matrix,
        html[data-site-background='searchlight'] .site-background-layer--searchlight,
        html[data-site-background='aurora'] .site-background-layer--aurora,
        html:not([data-site-background]) .site-background-layer--searchlight {
          opacity: 0.72;
        }
      }

      .site-searchlight {
        position: absolute;
        inset: auto;
        width: 42vw;
        height: 42vw;
        min-width: 22rem;
        min-height: 22rem;
        border-radius: 999px;
        background:
          radial-gradient(circle, rgba(255, 255, 255, 0.16) 0%, rgba(74, 222, 128, 0.12) 28%, rgba(59, 130, 246, 0.08) 52%, transparent 72%);
        filter: blur(20px);
        opacity: 0.72;
        mix-blend-mode: screen;
        animation: site-searchlight-drift linear infinite;
      }

      .site-searchlight--one {
        top: var(--site-searchlight-one-top, -8vw);
        left: var(--site-searchlight-one-left, -12vw);
        animation-duration: 36s;
      }

      .site-searchlight--two {
        top: var(--site-searchlight-two-top, 18vh);
        right: var(--site-searchlight-two-right, -10vw);
        width: 34vw;
        height: 34vw;
        animation-duration: 30s;
        animation-direction: reverse;
      }

      .site-searchlight--three {
        bottom: var(--site-searchlight-three-bottom, -12vw);
        left: var(--site-searchlight-three-left, 24vw);
        width: 30vw;
        height: 30vw;
        animation-duration: 40s;
      }

      .site-searchlight-beam {
        position: absolute;
        inset: -10% auto auto 50%;
        width: 20vw;
        height: 120vh;
        transform: translateX(-50%) rotate(8deg);
        transform-origin: center;
        background: linear-gradient(to bottom, rgba(74, 222, 128, 0.14), rgba(59, 130, 246, 0.06), transparent 68%);
        filter: blur(14px);
        opacity: 0.42;
        animation: site-searchlight-sweep 28s ease-in-out infinite;
      }

      .site-aurora-glow {
        position: absolute;
        border-radius: 999px;
        filter: blur(54px);
        opacity: 0.68;
        mix-blend-mode: screen;
        animation: site-aurora-float ease-in-out infinite alternate;
      }

      .site-aurora-glow--one {
        top: var(--site-aurora-one-top, -8vh);
        left: var(--site-aurora-one-left, -4vw);
        width: 46vw;
        height: 38vh;
        background: radial-gradient(circle, rgba(74, 222, 128, 0.24), transparent 72%);
        animation-duration: 18s;
      }

      .site-aurora-glow--two {
        top: var(--site-aurora-two-top, 14vh);
        right: var(--site-aurora-two-right, -8vw);
        width: 42vw;
        height: 42vh;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.22), transparent 72%);
        animation-duration: 22s;
      }

      .site-aurora-glow--three {
        bottom: var(--site-aurora-three-bottom, -10vh);
        left: var(--site-aurora-three-left, 18vw);
        width: 54vw;
        height: 42vh;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.16), transparent 72%);
        animation-duration: 26s;
      }

      .site-pane {
        display: block;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--site-border);
        border-radius: 30px;
        background: var(--site-pane);
        backdrop-filter: blur(18px) saturate(1.15);
        -webkit-backdrop-filter: blur(18px) saturate(1.15);
        box-shadow: 0 24px 72px rgba(0, 0, 0, 0.34);
      }

      .site-pane--strong {
        background: var(--site-pane-strong);
      }

      .site-pane::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 28%),
          linear-gradient(135deg, rgba(255, 255, 255, 0.02), transparent 35%);
        opacity: 0.9;
      }

      .site-pane-inner {
        position: relative;
        z-index: 1;
        padding: clamp(1.5rem, 3vw, 2.5rem);
      }

      .site-stack {
        display: flex;
        flex-direction: column;
        gap: clamp(2rem, 5vw, 4rem);
      }

      .site-page-heading {
        display: grid;
        gap: 0.75rem;
        width: 100%;
      }

      .site-page-heading::after {
        content: '';
        width: min(12rem, 42vw);
        height: 1px;
        background: linear-gradient(to right, rgba(74, 222, 128, 0.9), transparent);
      }

      .site-top-hero {
        display: grid;
        gap: 1rem;
      }

      .site-top-hero-copy {
        display: flex;
        flex-direction: column;
        min-height: 100%;
      }

      .site-title {
        margin: 0.5rem 0 0;
        font-family: inherit;
        font-weight: 700;
        width: 100%;
        font-size: clamp(2.1rem, 4.4vw, 4rem);
        line-height: 1;
      }

      .site-article-head .site-title {
        margin-top: 0.25rem;
        font-size: clamp(1.75rem, 3.4vw, 3rem);
        line-height: 1.05;
      }

      .site-copy {
        max-width: 42rem;
        margin-top: 1rem;
        line-height: 1.85;
        color: var(--site-muted);
      }

      .site-eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--site-dim);
      }

      .site-badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
      }

      .site-top-hero-copy .site-badge-row {
        margin-top: auto;
        padding-top: 2rem;
      }

      .site-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 0.55rem 0.85rem;
        font-size: 0.62rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.03);
      }

      .site-button-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        padding: 0.65rem 1rem;
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 10px 28px rgba(0, 0, 0, 0.24);
        color: var(--site-text);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }

      .site-meta-row,
      .site-entry-meta,
      .site-article-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
      }

      .site-date {
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(167, 243, 208, 0.98);
      }

      .site-project-hero-grid,
      .site-article-head {
        display: grid;
        gap: 1rem;
      }

      .site-article-head {
        padding: clamp(1.1rem, 2.2vw, 1.8rem) clamp(1.5rem, 3vw, 2.5rem);
      }

      .site-project-grid {
        display: grid;
        gap: 1rem;
      }

      .site-project-archive-grid {
        display: grid;
        gap: 1rem;
      }

      .site-project-tile {
        display: grid;
        gap: 1rem;
      }

      .site-project-tile-image-wrap {
        position: relative;
      }

      .site-project-tile > .site-pane-inner {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        gap: 1rem;
      }

      .site-project-tile-image {
        min-height: 10rem;
        border-radius: 22px;
        background-color: rgba(255, 255, 255, 0.04);
        background-image:
          radial-gradient(circle at 20% 20%, rgba(74, 222, 128, 0.28), transparent 32%),
          radial-gradient(circle at 80% 0%, rgba(59, 130, 246, 0.22), transparent 28%),
          var(--site-hero-image, none);
        background-size: cover, cover, cover;
        background-position: center, center, center;
        background-repeat: no-repeat, no-repeat, no-repeat;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .site-project-tile-image-wrap .site-project-tile-image {
        min-height: 12rem;
        width: 100%;
        border-radius: 0;
        border: 0;
      }

      .site-project-tile-titlebar {
        position: absolute;
        inset: 0 0 auto 0;
        display: flex;
        align-items: flex-end;
        padding: 1rem;
        background: linear-gradient(to bottom, rgba(2, 6, 23, 0.72), rgba(2, 6, 23, 0.22) 72%, transparent);
      }

      .site-project-tile-titlebar .site-meta-row {
        width: 100%;
      }

      .site-protected-ribbon {
        position: absolute;
        top: 1rem;
        right: -3.8rem;
        z-index: 2;
        width: 12.5rem;
        transform: rotate(38deg);
        transform-origin: center;
        pointer-events: none;
      }

      .site-protected-ribbon span {
        display: block;
        padding: 0.52rem 0;
        border-top: 1px solid rgba(74, 222, 128, 0.72);
        border-bottom: 1px solid rgba(74, 222, 128, 0.72);
        background: linear-gradient(90deg, rgba(2, 6, 23, 0.92), rgba(74, 222, 128, 0.34), rgba(2, 6, 23, 0.92));
        color: rgba(236, 253, 245, 0.99);
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.34em;
        text-align: center;
        text-transform: uppercase;
        text-shadow: 0 0 12px rgba(74, 222, 128, 0.45);
        box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.2) inset, 0 12px 28px rgba(2, 6, 23, 0.34);
      }

      .site-project-hero-panel > .site-project-tile-image {
        min-height: 100%;
        border-radius: 0;
        border: 0;
      }

      .site-project-tile-title {
        margin: 0;
        font-size: clamp(1.35rem, 2.6vw, 2.25rem);
        line-height: 1.05;
      }

      .site-project-tile-summary {
        color: var(--site-muted);
        line-height: 1.8;
      }

      .site-project-subtitle,
      .site-summary {
        color: var(--site-muted);
        line-height: 1.8;
      }

      .site-project-hero-image {
        min-height: 14rem;
        border-radius: 24px;
        background-color: rgba(255, 255, 255, 0.04);
        background-image:
          linear-gradient(135deg, rgba(34, 197, 94, 0.22), transparent 45%),
          linear-gradient(225deg, rgba(59, 130, 246, 0.18), transparent 40%),
          var(--site-hero-image, none);
        background-size: cover, cover, cover;
        background-position: center, center, center;
        background-repeat: no-repeat, no-repeat, no-repeat;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .site-top-hero-panel-image {
        min-height: 18rem;
        background-color: rgba(255, 255, 255, 0.04);
        background-image:
          linear-gradient(135deg, rgba(34, 197, 94, 0.22), transparent 45%),
          linear-gradient(225deg, rgba(59, 130, 246, 0.18), transparent 40%),
          var(--site-hero-image, none);
        background-size: cover, cover, cover;
        background-position: center, center, center;
        background-repeat: no-repeat, no-repeat, no-repeat;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .site-project-hero-panel {
        display: flex;
        min-height: 18rem;
        border-radius: 0 30px 30px 0;
      }

      .site-project-hero-panel > .site-project-hero-image {
        flex: 1;
        min-height: 18rem;
        border-radius: 0;
        border: 0;
      }

      .site-top-hero-panel > .site-pane-inner {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        gap: 1rem;
      }

      .site-top-hero-panel .site-top-hero-panel-image {
        width: 100%;
        border-radius: 0;
        min-height: 18rem;
      }

      .site-top-hero-panel {
        border-radius: 0 30px 30px 0;
      }

      .site-top-hero-panel .site-tag-row {
        justify-content: flex-end;
      }

      .site-top-hero-panel .site-summary {
        display: block;
      }

      .site-top-hero-panel .site-action-row {
        justify-content: flex-end;
      }

      .site-entry-list {
        display: grid;
        gap: 1rem;
      }

      .site-entry-month-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .site-entry-month {
        padding: clamp(1.25rem, 2.8vw, 2rem);
      }

      .site-entry-item,
      .site-article-shell {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .site-entry-item {
        padding: clamp(1.25rem, 2.8vw, 2rem);
        min-height: 18rem;
      }

      .site-entry-item[id] {
        scroll-margin-top: 6rem;
      }

      .site-entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1rem;
        width: 100%;
      }

      .site-entry-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
        width: 100%;
      }

      .site-entry-title {
        margin: 0;
        font-size: clamp(1.25rem, 2.6vw, 2rem);
        line-height: 1.1;
        view-transition-name: none;
      }

      .site-entry-summary {
        color: var(--site-muted);
        line-height: 1.75;
      }

      .site-tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .site-meta-spacer {
        flex: 1 1 auto;
        min-width: 0.75rem;
      }

      .site-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 0.72rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
        color: var(--site-muted);
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .site-action-row,
      .site-article-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
      }

      .site-article-head .site-article-nav {
        margin-top: 0.5rem;
      }

      .site-article-nav > .site-chip:first-child {
        margin-right: auto;
      }

      .site-entry-content .site-action-row {
        margin-top: auto;
        justify-content: flex-end;
      }

      .site-project-tile .site-action-row {
        margin-top: auto;
        justify-content: flex-end;
      }

      .site-project-archive-sidebar {
        height: fit-content;
        border-radius: 14px;
      }

      .site-project-archive-year-list {
        display: grid;
        gap: 0.75rem;
      }

      .site-project-archive-year-group {
        display: grid;
        gap: 0.5rem;
      }

      .site-project-archive-month-list {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .site-project-archive-month-link {
        display: flex;
        justify-content: flex-start;
        gap: 0.75rem;
        width: 100%;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        padding: 0.45rem 0.65rem;
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--site-text);
      }

      .site-project-archive-month-link span:last-child {
        margin-left: auto;
        color: rgba(167, 243, 208, 0.98);
      }

      .site-project-archive-month-link[aria-current='page'] {
        border-color: rgba(74, 222, 128, 0.45);
        background: rgba(74, 222, 128, 0.09);
      }

      .site-project-archive-sidebar > .site-pane-inner {
        padding: 0.75rem;
      }

      .site-detail-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.8rem;
        padding: 0.7rem 1rem;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.05);
        color: var(--site-text);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .site-article-body {
        display: grid;
        gap: 1rem;
        color: var(--site-muted);
        line-height: 1.9;
      }

      .site-article-body h1 {
        margin: 0;
        max-width: none;
        color: var(--site-text);
        font-family: inherit;
        font-weight: 700;
        font-size: clamp(1.55rem, 3.4vw, 2.6rem);
        line-height: 1.08;
        letter-spacing: 0;
        text-wrap: balance;
      }

      .site-entry-item {
        view-transition-name: none;
      }

      .site-article-head {
        view-transition-name: article-pane;
      }

      .site-article-head .site-title {
        view-transition-name: none;
      }

      ::view-transition-group(article-pane) {
        animation-duration: 420ms;
        animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      ::view-transition-old(article-pane) {
        animation: site-article-pane-out 280ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }

      ::view-transition-new(article-pane) {
        animation: site-article-pane-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
        transform-origin: left top;
      }

      @keyframes site-article-pane-out {
        from {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
        to {
          opacity: 0;
          transform: translateY(-0.2rem) scale(0.96);
          filter: blur(3px);
        }
      }

      @keyframes site-article-pane-in {
        from {
          opacity: 0;
          transform: translateY(0.5rem) scale(0.86);
          filter: blur(4px);
        }
        65% {
          opacity: 1;
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
      }

      @keyframes site-searchlight-drift {
        0% {
          transform: translate3d(0, 0, 0) scale(0.99);
        }
        50% {
          transform: translate3d(1.2vw, 1.8vh, 0) scale(1.02);
        }
        100% {
          transform: translate3d(-0.8vw, -1.4vh, 0) scale(1);
        }
      }

      @keyframes site-searchlight-sweep {
        0% {
          transform: translateX(-52%) rotate(8deg) translateY(-6vh);
          opacity: 0.18;
        }
        50% {
          transform: translateX(-49%) rotate(9deg) translateY(2vh);
          opacity: 0.34;
        }
        100% {
          transform: translateX(-50%) rotate(8deg) translateY(-5vh);
          opacity: 0.18;
        }
      }

      @keyframes site-aurora-float {
        0% {
          transform: translate3d(0, 0, 0) scale(0.98);
        }
        100% {
          transform: translate3d(0, 4vh, 0) scale(1.04);
        }
      }

      .site-article-body h1::before {
        content: '';
        display: block;
        width: min(3rem, 22vw);
        height: 1px;
        margin: 0 0 0.6rem;
        background: linear-gradient(to right, rgba(74, 222, 128, 0.95), transparent);
      }

      .site-article-body h2,
      .site-article-body h3,
      .site-article-body h4 {
        color: var(--site-text);
        line-height: 1.2;
        margin: 1.6rem 0 0.65rem;
      }

      .site-article-body h2 {
        font-size: clamp(1.25rem, 2.1vw, 1.6rem);
      }

      .site-article-body p {
        margin: 0;
      }

      .site-article-body blockquote {
        margin: 0;
        padding: 0.8rem 1rem;
        border-left: 2px solid rgba(74, 222, 128, 0.6);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 0 12px 12px 0;
      }

      .site-article-body pre {
        overflow-x: auto;
        padding: 1rem 1.1rem;
        border-radius: 16px;
        background: rgba(8, 15, 32, 0.96);
        border: 1px solid rgba(110, 231, 183, 0.2);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 12px 30px rgba(0, 0, 0, 0.22);
      }

      .site-article-body .shiki {
        margin: 0;
        overflow-x: auto;
        border-radius: 16px;
      }

      .site-article-body .shiki code {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.9rem;
      }

      .site-article-body code {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.9em;
      }

      .site-article-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 0.25rem 0 0;
        border-radius: 14px;
        border: 1px solid rgba(110, 231, 183, 0.18);
        background: rgba(255, 255, 255, 0.02);
      }

      .site-article-body table code {
        white-space: nowrap;
      }

      .site-article-body th,
      .site-article-body td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.8rem 0.95rem;
        text-align: left;
      }

      .site-article-body th {
        color: var(--site-text);
        background: rgba(255, 255, 255, 0.03);
        font-weight: 700;
      }

      .site-article-body img {
        max-width: 100%;
        border-radius: 18px;
      }

      .site-article-body .mermaid {
        margin: 1rem 0;
        overflow-x: auto;
      }

      .site-article-body .mermaid svg {
        max-width: 100%;
        height: auto;
      }

      .site-article-body ul,
      .site-article-body ol {
        margin: 0;
        padding-left: 1.25rem;
      }

      .site-article-body li + li {
        margin-top: 0.35rem;
      }

      .site-article-body hr {
        width: 100%;
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 1.25rem 0;
      }

      .site-matrix {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
      }

      @keyframes site-fall {
        0% {
          transform: translateX(var(--drift)) translateY(-34vh) rotate(0deg);
          opacity: 0;
        }
        12% {
          opacity: 1;
        }
        100% {
          transform: translateX(calc(var(--drift) * 1.7)) translateY(250vh) rotate(360deg);
          opacity: 0;
        }
      }

      @media (min-width: 900px) {
        .site-top-hero {
          grid-template-columns: 1.2fr 0.8fr;
          align-items: start;
        }

        .site-project-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .site-project-hero-grid {
          grid-template-columns: 1.1fr 0.9fr;
          align-items: start;
        }

        .site-project-archive-grid {
          grid-template-columns: minmax(0, 1fr) minmax(12rem, 13rem);
          align-items: start;
        }

        .site-project-archive-sidebar {
          position: sticky;
          top: 6rem;
        }

        .site-article-shell {
          gap: 1.25rem;
        }
      }
    </style>
  </head>
  <body hx-boost="true" hx-target="#site-main" hx-swap="outerHTML transition:true" hx-select="#site-main" hx-push-url="true">
    <div class="site-shell">
      <div class="site-progress" aria-hidden="true"></div>
      <div class="site-background" aria-hidden="true">
        <div class="site-background-layer site-background-layer--matrix">
          <div class="site-matrix">
            <div class="site-columns">
              {_columns.map((column, columnIndex) => (
                <div
                  class="site-column"
                  style={`left: ${(columnIndex + 1) * 6.5}vw; animation-delay: ${columnIndex * 0.08}s;`}
                >
                  {column.map((cell) => (
                    <span
                      class="site-cell"
                      style={`top: ${cell.top}; animation-delay: ${cell.delay}; animation-duration: ${cell.duration}; opacity: ${cell.opacity}; font-size: ${cell.size}; --drift: ${cell.drift};`}
                    >
                      {cell.symbol}
                    </span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="site-background-layer site-background-layer--searchlight">
          <div class="site-searchlight site-searchlight--one"></div>
          <div class="site-searchlight site-searchlight--two"></div>
          <div class="site-searchlight site-searchlight--three"></div>
          <div class="site-searchlight-beam"></div>
        </div>
        <div class="site-background-layer site-background-layer--aurora">
          <div class="site-aurora-glow site-aurora-glow--one"></div>
          <div class="site-aurora-glow site-aurora-glow--two"></div>
          <div class="site-aurora-glow site-aurora-glow--three"></div>
        </div>
      </div>

      <header class="site-header">
        <div
          class="site-container"
          style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-top:1rem; padding-bottom:1rem;"
        >
          <a href="/" class="site-brand">
            <div class="site-brand-mark"></div>
            <div>
              <div class="site-brand-title">{siteConfig.siteTitle}</div>
              <div class="site-brand-subtitle">{siteConfig.siteSubTitle}</div>
            </div>
          </a>

          <nav class="site-nav">
            <a class="site-chip" href="/">Home</a>
            <a class="site-chip" href="/journal/">Project</a>
            <a class="site-chip" href="/entries/journal-sample-1/">Article</a>
          </nav>
        </div>
      </header>

      <main id="site-main" class="site-main">
        <slot />
      </main>
    </div>
    <script is:inline>
      (() => {
        const progress = document.querySelector('.site-progress')
        if (!progress || !window.htmx) return

        window.htmx.config.globalViewTransitions = true

        let activePane = null
        const clearActivePane = () => {
          if (!activePane) return
          activePane.style.removeProperty('view-transition-name')
          delete activePane.dataset.vtActive
          activePane = null
        }

        const updateTitleFromResponse = (event) => {
          const responseText = event?.detail?.xhr?.responseText
          if (typeof responseText !== 'string' || responseText.length === 0) return

          const parsed = new DOMParser().parseFromString(responseText, 'text/html')
          const nextTitle = parsed.querySelector('title')?.textContent?.trim()
          if (nextTitle) {
            document.title = nextTitle
          }
        }

        document.body.addEventListener(
          'click',
          (event) => {
            const target = event.target
            if (!(target instanceof Element)) return

            const link = target.closest('a.site-detail-button, a.site-entry-title-link')
            if (!link) return

            const entry = link.closest('.site-entry-item')
            if (!entry) return

            if (!(entry instanceof HTMLElement)) return

            clearActivePane()
            entry.style.setProperty('view-transition-name', 'article-pane')
            entry.dataset.vtActive = 'true'
            activePane = entry
          },
          true,
        )

        document.body.addEventListener('htmx:beforeRequest', () => {
          progress.classList.add('is-active')
        })
        document.body.addEventListener('htmx:afterRequest', () => {
          progress.classList.remove('is-active')
          clearActivePane()
        })
        document.body.addEventListener('htmx:responseError', () => {
          progress.classList.remove('is-active')
          clearActivePane()
        })
        document.body.addEventListener('htmx:afterSwap', updateTitleFromResponse)
      })()
    </script>
  </body>
</html>
